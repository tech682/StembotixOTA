        if (lcdReady && lcdI2c != nullptr) lcdI2c->setCursor(col, row);
        else if (lcdStdReady) lcdStdCmd((uint8_t)(row == 0 ? 0x80 + col : 0xC0 + col));
        server.send(200, "text/plain", "OK");
      } else {
        server.send(400, "text/plain", "NOT_INITIALIZED");
      }
      return;
    }

    if (cmd.startsWith("LCD_PRINT_NUMBER")) {
      int no;
      float value;
      if (sscanf(cmd.c_str(), "LCD_PRINT_NUMBER %d %f", &no, &value) == 2 && lcdAnyReady()) {
        lcdWriteText(String(value));
        server.send(200, "text/plain", "OK");
      } else {
        server.send(400, "text/plain", "NOT_INITIALIZED");
      }
      return;
    }

    if (cmd.startsWith("LCD_PRINT_CHAR")) {
      int no, code;
      if (sscanf(cmd.c_str(), "LCD_PRINT_CHAR %d %d", &no, &code) == 2 && lcdAnyReady()) {
        if (lcdReady && lcdI2c != nullptr) lcdI2c->write((uint8_t)code);
        else if (lcdStdReady) lcdStdData((uint8_t)code);
        server.send(200, "text/plain", "OK");
      } else {
        server.send(400, "text/plain", "NOT_INITIALIZED");
      }
      return;
    }

