    // ================= PS2 JOYSTICK =================
    if (cmd.startsWith("JOYSTICK_INIT")) {
      int no, xPin, yPin, swPin = -1;
      char xText[12], yText[12], swText[12];
      int parsed = sscanf(cmd.c_str(), "JOYSTICK_INIT %d %11s %11s %11s", &no, xText, yText, swText);
      if (parsed >= 3 && no >= 0 && no < JOYSTICK_MAX) {
        xPin = parseWifiPin(xText);
        yPin = parseWifiPin(yText);
        swPin = parsed == 4 ? parseWifiPin(swText) : -1;
        joystickXPin[no] = xPin;
        joystickYPin[no] = yPin;
        joystickSwPin[no] = swPin;
        pinMode(xPin, INPUT);
        pinMode(yPin, INPUT);
#if defined(ARDUINO_ARCH_ESP32)
        analogReadResolution(12);
        analogSetPinAttenuation(xPin, ADC_11db);
        analogSetPinAttenuation(yPin, ADC_11db);
        if (swPin >= 0) pinMode(swPin, (swPin >= 34 && swPin <= 39) ? INPUT : INPUT_PULLUP);
#else
        if (swPin >= 0) pinMode(swPin, INPUT_PULLUP);
#endif
        delay(30);
        long sumX = 0, sumY = 0;
        for (int i = 0; i < 8; i++) {
          delay(5);
          sumX += analogRead(xPin);
          sumY += analogRead(yPin);
        }
        joystickCenterX[no] = sumX / 8;
        joystickCenterY[no] = sumY / 8;
        server.send(200, "text/plain", "OK");
      } else {
        server.send(400, "text/plain", "INVALID_FORMAT");
      }
