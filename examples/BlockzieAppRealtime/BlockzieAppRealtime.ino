        RgbLedEntry* px = rgbLedGetEntry(pin);
        if (px != nullptr) {
          char* start = colourText[0] == '#' ? colourText + 1 : colourText;
          unsigned long colour = strtoul(start, NULL, 16);
          px->r = (colour >> 16) & 0xFF;
          px->g = (colour >> 8) & 0xFF;
          px->b = colour & 0xFF;
          rgbLedApply(px);
          server.send(200, "text/plain", "OK");
        } else {
          server.send(400, "text/plain", "NOT_INITIALIZED");
