        else if (strcmp(action, "noCursor") == 0) lcdI2c->noCursor();
        else if (strcmp(action, "blink") == 0) lcdI2c->blink();
        else if (strcmp(action, "noBlink") == 0) lcdI2c->noBlink();
        else if (strcmp(action, "scrollLeft") == 0) lcdI2c->scrollDisplayLeft();
