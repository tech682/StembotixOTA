        ? sscanf(cmd.c_str(), "RGBLED_GET_CHANNEL %d %3s", &pin, channel)
        : sscanf(cmd.c_str(), "RGBLED_GET %d %3s", &pin, channel);
      if (parsed == 2) {
        RgbLedEntry* px = rgbLedGetEntry(pin);
        if (px != nullptr) {
          int value = px->r;
          if (channel[0] == 'G' || channel[0] == 'g') value = px->g;
          else if (channel[0] == 'B' || channel[0] == 'b') value = px->b;
          server.send(200, "text/plain", String(value));
