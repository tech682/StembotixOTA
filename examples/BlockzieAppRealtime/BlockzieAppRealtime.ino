        int y = analogRead(yPin);
        int sw = (joystickSwPin[0] > 0) ? digitalRead(joystickSwPin[0]) : 1;
        server.send(200, "text/plain", "PS2 " + String(x) + " " + String(y) + " " + String(sw));
      } else {
        server.send(400, "text/plain", "INVALID_FORMAT");
      }
