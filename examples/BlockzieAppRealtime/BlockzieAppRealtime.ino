      int no, addr, chip;
      if (sscanf(cmd.c_str(), "LCD_INIT_I2C %d %i %d", &no, &addr, &chip) == 3) {
        int cols = chip == 2004 ? 20 : 16;
        int rows = chip == 2004 ? 4 : 2;
        if (lcdDoInit(addr, cols, rows, 21, 22)) {
          server.send(200, "text/plain", "LCD_OK");
        } else {
          server.send(400, "text/plain", "ERR:LCD_I2C");
        }
      } else {
        server.send(400, "text/plain", "INVALID_FORMAT");
      }
