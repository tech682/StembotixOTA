int lcdStdRs = -1, lcdStdE = -1, lcdStdD4 = -1, lcdStdD5 = -1, lcdStdD6 = -1, lcdStdD7 = -1;
bool lcdStdReady = false;

void lcdStdPulse() {
  digitalWrite(lcdStdE, HIGH);
  delayMicroseconds(1);
  digitalWrite(lcdStdE, LOW);
  delayMicroseconds(50);
}

void lcdStdNibble(uint8_t nibble) {
  digitalWrite(lcdStdD4, nibble & 0x01);
  digitalWrite(lcdStdD5, (nibble >> 1) & 0x01);
  digitalWrite(lcdStdD6, (nibble >> 2) & 0x01);
  digitalWrite(lcdStdD7, (nibble >> 3) & 0x01);
  lcdStdPulse();
}

void lcdStdCmd(uint8_t value) {
  digitalWrite(lcdStdRs, LOW);
  lcdStdNibble(value >> 4);
  lcdStdNibble(value & 0x0F);
}

void lcdStdData(uint8_t value) {
  digitalWrite(lcdStdRs, HIGH);
  lcdStdNibble(value >> 4);
  lcdStdNibble(value & 0x0F);
}

void lcdStdInit(int rs, int e, int d4, int d5, int d6, int d7) {
  lcdStdRs = rs; lcdStdE = e; lcdStdD4 = d4; lcdStdD5 = d5; lcdStdD6 = d6; lcdStdD7 = d7;
  pinMode(rs, OUTPUT); pinMode(e, OUTPUT);
  pinMode(d4, OUTPUT); pinMode(d5, OUTPUT); pinMode(d6, OUTPUT); pinMode(d7, OUTPUT);
  delay(50);
  lcdStdNibble(0x03); delay(5);
  lcdStdNibble(0x03); delayMicroseconds(150);
  lcdStdNibble(0x03); delayMicroseconds(150);
  lcdStdNibble(0x02);
  lcdStdCmd(0x28);
  lcdStdCmd(0x0C);
  lcdStdCmd(0x01);
  delay(2);
  lcdStdCmd(0x06);
  lcdStdReady = true;
}

bool lcdAnyReady() {
  return (lcdReady && lcdI2c != nullptr) || lcdStdReady;
}

void lcdWriteText(const String& text) {
  if (lcdReady && lcdI2c != nullptr) lcdI2c->print(text);
  else if (lcdStdReady) {
    for (unsigned i = 0; i < text.length(); i++) lcdStdData((uint8_t)text[i]);
  }
}

int readHallSafe() {
#if defined(ESP_ARDUINO_VERSION_MAJOR) && (ESP_ARDUINO_VERSION_MAJOR >= 3)
  return 0;
#else
  return hallRead();
#endif
}

void writeDacSafe(int pin, int value) {
  value = constrain(value, 0, 255);
  if (pin == 25 || pin == 26) {
    dacWrite(pin, value);
    return;
  }
  analogWrite(pin, value);          // PWM, works on ESP32 core 2.x and 3.x
}

void initializeWiFi() {
#if defined(ARDUINO_ARCH_ESP32)
  WRITE_PERI_REG(RTC_CNTL_BROWN_OUT_REG, 0);
#endif
  WiFi.persistent(false);
  WiFi.mode(WIFI_STA);
  WiFi.setSleep(false);
  Serial.println("Connecting to WiFi...");
  for (int round = 0; round < 4; round++) {
    Serial.print("WiFi try ");
    Serial.println(round + 1);
    WiFi.disconnect(false, false);
    delay(200);
    WiFi.begin(ssid, password);
    unsigned long startAttemptTime = millis();
    while (WiFi.status() != WL_CONNECTED) {
      if (millis() - startAttemptTime >= 12000) break;
      delay(500);
      Serial.print(".");
    }
    Serial.println("");
    if (WiFi.status() == WL_CONNECTED) break;
    Serial.println("WiFi retry...");
  }

  if (WiFi.status() == WL_CONNECTED) {
    Serial.println("Connected to WiFi");
    Serial.flush();
    delay(300);
    IPAddress ip = WiFi.localIP();
    Serial.print("IP ");
    Serial.print((int)ip[0]);
    Serial.print(".");
    Serial.print((int)ip[1]);
    Serial.print(".");
    Serial.print((int)ip[2]);
    Serial.print(".");
    Serial.println((int)ip[3]);
    Serial.flush();
  } else {
    Serial.println("WiFi not joined yet. HTTP server still starts; will retry in loop.");
  }

  server.on("/connect", HTTP_GET, []() {
    server.sendHeader("Access-Control-Allow-Origin", "*");
    server.send(200, "text/plain", "OK");
  });
  server.on("/connect", HTTP_POST, []() {
    server.sendHeader("Access-Control-Allow-Origin", "*");
    server.send(200, "text/plain", "OK");
  });
  server.on("/connect", HTTP_OPTIONS, []() {
    server.sendHeader("Access-Control-Allow-Origin", "*");
    server.sendHeader("Access-Control-Allow-Methods", "GET, POST, OPTIONS");
    server.sendHeader("Access-Control-Allow-Headers", "Content-Type");
    server.send(204, "text/plain", "");
  });
  server.on("/disconnect", HTTP_GET, []() {
    server.sendHeader("Access-Control-Allow-Origin", "*");
    server.send(200, "text/plain", "OK");
  });
  server.on("/disconnect", HTTP_POST, []() {
    server.sendHeader("Access-Control-Allow-Origin", "*");
    server.send(200, "text/plain", "OK");
  });

  server.on("/control", HTTP_POST, []() {
    server.sendHeader("Access-Control-Allow-Origin", "*");

    String cmd;
    if (server.hasArg("plain")) {
      cmd = server.arg("plain");
    } else if (server.hasArg("body")) {
      cmd = server.arg("body");
    } else {
      server.send(400, "text/plain", "No data");
      return;
    }
    cmd.trim();
    if (cmd == "COLOUR_INIT") cmd = "TCS34725_INIT";
    else if (cmd.startsWith("COLOUR_LED")) cmd.replace("COLOUR_LED", "TCS34725_LED");
    else if (cmd == "COLOUR_READ") cmd = "TCS34725_READ";
    else if (cmd.startsWith("COLOUR_TEMP")) cmd = "TCS34725_COLOR_TEMP";
    else if (cmd.startsWith("COLOUR_LUX")) cmd = "TCS34725_LUX";
    else if (cmd.startsWith("COLOUR_IS ")) cmd.replace("COLOUR_IS ", "TCS34725_IS_COLOR ");
    else if (cmd.startsWith("COLOUR_NAME")) cmd = "TCS34725_GET_NAME";
    else if (cmd.startsWith("COLOUR_GET_RGB")) cmd = "TCS34725_GET_RGB";
    else if (cmd.startsWith("ENCODER_LISTEN_BUTTON")) cmd.replace("ENCODER_LISTEN_BUTTON", "ENCODER_BUTTON_LISTEN");
    else if (cmd.startsWith("LCD_WRITE ")) cmd.replace("LCD_WRITE ", "LCD_PRINT_CHAR ");
    else if (cmd.startsWith("LEDMATRIX_LETTER")) cmd.replace("LEDMATRIX_LETTER", "LEDMATRIX_CHAR");
    else if (cmd.startsWith("ULTRASONIC_DIST ") || cmd.startsWith("ULTRASONIC_D ")) {
      cmd.replace("ULTRASONIC_DIST ", "ULTRASONIC_READ ");
      cmd.replace("ULTRASONIC_D ", "ULTRASONIC_READ ");
    }
    Serial.println("Received: " + cmd);

    // ================= SET PIN MODE =================
    if (cmd.startsWith("SET_PIN_MODE")) {
      int pin;
      char mode[10];
      if (sscanf(cmd.c_str(), "SET_PIN_MODE %d %s", &pin, mode) == 2) {
        pinMode(pin, strcmp(mode, "INPUT") == 0 ? INPUT :
          (strcmp(mode, "INPUT_PULLUP") == 0 ? INPUT_PULLUP : OUTPUT));
        server.send(200, "text/plain", "OK");
      } else {
        server.send(400, "text/plain", "INVALID_FORMAT");
      }
      return;
    }

    // ================= SET DIGITAL OUTPUT =================
    if (cmd.startsWith("SET_DIGITAL_OUTPUT")) {
      int pin[4];
      char state[4][10];
      int count = sscanf(
        cmd.c_str(),
        "SET_DIGITAL_OUTPUT %d %s %d %s %d %s %d %s",
        &pin[0], state[0],
        &pin[1], state[1],
        &pin[2], state[2],
        &pin[3], state[3]
      );
      for (int i = 0; i < count / 2; i++) {
        pinMode(pin[i], OUTPUT);
        digitalWrite(pin[i], strcmp(state[i], "HIGH") == 0 ? HIGH : LOW);
      }
      delay(50);
      server.send(200, "text/plain", "OK");
      return;
    }

    // ================= DIGITAL WRITE =================
    if (cmd.startsWith("DIGITAL_WRITE")) {
      int pin, val;
      if (sscanf(cmd.c_str(), "DIGITAL_WRITE %d %d", &pin, &val) == 2) {
        pinMode(pin, OUTPUT);
        digitalWrite(pin, val);
        server.send(200, "text/plain", "OK");
      } else {
        server.send(400, "text/plain", "INVALID_FORMAT");
      }
      return;
    }

    // ================= DIGITAL READ =================
    if (cmd.startsWith("DIGITAL_READ") || cmd.startsWith("READ_DIGITAL_PIN")) {
      int pin;
      int parsed = cmd.startsWith("READ_DIGITAL_PIN")
        ? sscanf(cmd.c_str(), "READ_DIGITAL_PIN %d", &pin)
        : sscanf(cmd.c_str(), "DIGITAL_READ %d", &pin);
      if (parsed == 1) {
        pinMode(pin, INPUT);
        int value = digitalRead(pin);
        server.send(200, "text/plain", String(value));
      } else {
        server.send(400, "text/plain", "INVALID_FORMAT");
      }
      return;
    }

    // ================= ANALOG READ =================
    if (cmd.startsWith("READ_ANALOG")) {
      int pin;
      if (sscanf(cmd.c_str(), "READ_ANALOG %d", &pin) == 1) {
        int value = analogRead(pin);
        server.send(200, "text/plain", String(value));
      } else {
        server.send(400, "text/plain", "INVALID_FORMAT");
      }
      return;
    }

    // ================= PWM OUTPUT =================
    if (cmd.startsWith("SET_PWM_OUTPUT")) {
      int pin, value;
      if (sscanf(cmd.c_str(), "SET_PWM_OUTPUT %d %d", &pin, &value) == 2) {
        analogWrite(pin, constrain(value, 0, 255));   // PWM, works on ESP32 core 2.x and 3.x
        server.send(200, "text/plain", "OK");
      } else {
        server.send(400, "text/plain", "INVALID_FORMAT");
      }
      return;
    }

    // ================= SERVO OUTPUT =================
    if (cmd.startsWith("SET_SERVO_OUTPUT")) {
      int pin, angle;
      if (sscanf(cmd.c_str(), "SET_SERVO_OUTPUT %d %d", &pin, &angle) == 2) {
        __blockly_servo__.attach(pin);
        __blockly_servo__.write(angle);
        server.send(200, "text/plain", "OK");
      } else {
        server.send(400, "text/plain", "INVALID_FORMAT");
      }
      return;
    }

    if (cmd.startsWith("SERVO_ATTACH")) {
      int pin;
      if (sscanf(cmd.c_str(), "SERVO_ATTACH %d", &pin) == 1) {
        __blockly_servo__.attach(pin);
        server.send(200, "text/plain", "OK");
      } else {
        server.send(400, "text/plain", "INVALID_FORMAT");
      }
      return;
    }

    if (cmd.startsWith("SET_DAC_OUTPUT")) {
      int pin, value;
      if (sscanf(cmd.c_str(), "SET_DAC_OUTPUT %d %d", &pin, &value) == 2) {
        writeDacSafe(pin, value);
        server.send(200, "text/plain", "OK");
      } else {
        server.send(400, "text/plain", "INVALID_FORMAT");
      }
      return;
    }

    if (cmd.startsWith("READ_TOUCH_PIN")) {
      int pin;
      if (sscanf(cmd.c_str(), "READ_TOUCH_PIN %d", &pin) == 1) {
        server.send(200, "text/plain", String(touchRead(pin)));
      } else {
        server.send(400, "text/plain", "INVALID_FORMAT");
      }
      return;
    }

    if (cmd.startsWith("READ_HALL_SENSOR")) {
      server.send(200, "text/plain", String(readHallSafe()));
      return;
    }

    if (cmd.startsWith("GET_MILLIS")) {
      server.send(200, "text/plain", String(millis()));
      return;
    }

    if (cmd.startsWith("RESET_TIMER")) {
      projectTimerStart = millis();
      server.send(200, "text/plain", "OK");
      return;
    }

    if (cmd.startsWith("GET_TIMER")) {
      server.send(200, "text/plain", String(millis() - projectTimerStart));
      return;
    }

    if (cmd.startsWith("ATTACH_INTERRUPT")) {
      int pin;
      char mode[16];
      if (sscanf(cmd.c_str(), "ATTACH_INTERRUPT %d %15s", &pin, mode) == 2 && pin >= 0 && pin < 40) {
        irqFired[pin] = false;
        irqArmed[pin] = true;
        attachIrqPin(pin, irqModeFromText(mode));
        server.send(200, "text/plain", "OK");
      } else {
        server.send(400, "text/plain", "INVALID_FORMAT");
      }
      return;
    }

    if (cmd.startsWith("INTERRUPT_FIRED")) {
      int pin;
      if (sscanf(cmd.c_str(), "INTERRUPT_FIRED %d", &pin) == 1 && pin >= 0 && pin < 40) {
        bool fired = irqFired[pin];
        irqFired[pin] = false;
        server.send(200, "text/plain", fired ? "1" : "0");
      } else {
        server.send(400, "text/plain", "INVALID_FORMAT");
      }
      return;
    }

    if (cmd.startsWith("DETACH_INTERRUPT")) {
      int pin;
      if (sscanf(cmd.c_str(), "DETACH_INTERRUPT %d", &pin) == 1 && pin >= 0 && pin < 40) {
        detachInterrupt(digitalPinToInterrupt(pin));
        irqArmed[pin] = false;
        irqFired[pin] = false;
        server.send(200, "text/plain", "OK");
      } else {
        server.send(400, "text/plain", "INVALID_FORMAT");
      }
      return;
    }

    if (cmd.startsWith("DATA_MAP")) {
      float data, inMin, inMax, outMin, outMax;
      if (sscanf(cmd.c_str(), "DATA_MAP %f %f %f %f %f", &data, &inMin, &inMax, &outMin, &outMax) == 5) {
        float mapped = (inMax == inMin) ? outMin : (data - inMin) * (outMax - outMin) / (inMax - inMin) + outMin;
        server.send(200, "text/plain", String(mapped));
      } else {
        server.send(400, "text/plain", "INVALID_FORMAT");
      }
      return;
    }

    if (cmd.startsWith("DATA_CONSTRAIN")) {
      float data, lo, hi;
      if (sscanf(cmd.c_str(), "DATA_CONSTRAIN %f %f %f", &data, &lo, &hi) == 3) {
        server.send(200, "text/plain", String(constrain(data, lo, hi)));
      } else {
        server.send(400, "text/plain", "INVALID_FORMAT");
      }
      return;
    }

    if (cmd.startsWith("DATA_CONVERT")) {
      char typ[16];
      int consumed = 0;
      if (sscanf(cmd.c_str(), "DATA_CONVERT %15s %n", typ, &consumed) >= 1 && consumed > 0) {
        String payload = cmd.substring(consumed);
        payload.trim();
        if (!strcasecmp(typ, "INTEGER")) server.send(200, "text/plain", String(payload.toInt()));
        else if (!strcasecmp(typ, "DECIMAL")) server.send(200, "text/plain", String(payload.toFloat()));
        else server.send(200, "text/plain", payload);
      } else {
        server.send(400, "text/plain", "INVALID_FORMAT");
      }
      return;
    }

    if (cmd.startsWith("DATA_ASCII_CHAR")) {
      int code;
      if (sscanf(cmd.c_str(), "DATA_ASCII_CHAR %d", &code) == 1) {
        char out[2] = { (char)(code & 0xFF), 0 };
        server.send(200, "text/plain", String(out));
      } else {
        server.send(400, "text/plain", "INVALID_FORMAT");
      }
      return;
    }

    if (cmd.startsWith("DATA_ASCII_NUM")) {
      String rest = cmd.substring(String("DATA_ASCII_NUM").length());
      rest.trim();
      int code = rest.length() > 0 ? (int)(uint8_t)rest.charAt(0) : 0;
      server.send(200, "text/plain", String(code));
      return;
    }

    // ================= TM1637 INIT =================
    if (cmd.startsWith("TM1637_INIT")) {
      int dio, clk;
      if (sscanf(cmd.c_str(), "TM1637_INIT %d %d", &dio, &clk) == 2) {
        if (tm1637Display == nullptr) {
          tm1637Display = new TM1637Display(clk, dio);
          tm1637Display->setBrightness(7);
          tm1637Display->clear();
        }
        server.send(200, "text/plain", "OK");
      } else {
        server.send(400, "text/plain", "INVALID_FORMAT");
      }
      return;
    }

    // ================= TM1637 BRIGHTNESS =================
    if (cmd.startsWith("TM1637_BRIGHTNESS")) {
      int brightness;
      if (sscanf(cmd.c_str(), "TM1637_BRIGHTNESS %d", &brightness) == 1 && tm1637Display != nullptr) {
        tm1637Display->setBrightness(brightness);
        server.send(200, "text/plain", "OK");
      } else {
        server.send(400, "text/plain", "NOT_INITIALIZED");
      }
      return;
    }

    // ================= TM1637 ADVANCED NUMBER =================
    if (cmd.startsWith("TM1637_NUMBER_EX")) {
      int number, length, position, leadingZeros;
      if (sscanf(cmd.c_str(), "TM1637_NUMBER_EX %d %d %d %d", &number, &length, &position, &leadingZeros) == 4 &&
          tm1637Display != nullptr) {
        length = constrain(length, 1, 4);
        position = constrain(position, 0, 3);
        if (position + length > 4) length = 4 - position;
        tm1637Display->showNumberDecEx(number, tm1637Dots, leadingZeros != 0, length, position);
        tm1637LastNumber = number;
        tm1637LastLength = length;
        tm1637LastPosition = position;
        tm1637LastLeadingZeros = leadingZeros != 0;
        tm1637HasLastNumber = true;
        server.send(200, "text/plain", "OK");
      } else {
        server.send(400, "text/plain", "NOT_INITIALIZED");
      }
      return;
    }

    if (cmd.startsWith("TM1637_NUMBER_DOTS")) {
      int number, length, position, dots, leadingZeros;
      if (sscanf(cmd.c_str(), "TM1637_NUMBER_DOTS %d %d %d %i %d",
          &number, &length, &position, &dots, &leadingZeros) == 5 && tm1637Display != nullptr) {
        length = constrain(length, 1, 4);
        position = constrain(position, 0, 3);
        if (position + length > 4) length = 4 - position;
        tm1637Dots = (uint8_t)dots;
        tm1637Display->showNumberDecEx(number, tm1637Dots, leadingZeros != 0, length, position);
        tm1637LastNumber = number;
        tm1637LastLength = length;
        tm1637LastPosition = position;
        tm1637LastLeadingZeros = leadingZeros != 0;
        tm1637HasLastNumber = true;
        server.send(200, "text/plain", "OK");
      } else {
        server.send(400, "text/plain", "NOT_INITIALIZED");
      }
      return;
    }

    // ================= TM1637 NUMBER =================
    if (cmd.startsWith("TM1637_NUMBER")) {
      int number;
      if (sscanf(cmd.c_str(), "TM1637_NUMBER %d", &number) == 1 && tm1637Display != nullptr) {
        tm1637Display->showNumberDecEx(number, tm1637Dots, false, 4, 0);
        tm1637LastNumber = number;
        tm1637LastLength = 4;
        tm1637LastPosition = 0;
        tm1637LastLeadingZeros = false;
        tm1637HasLastNumber = true;
        server.send(200, "text/plain", "OK");
      } else {
        server.send(400, "text/plain", "NOT_INITIALIZED");
      }
      return;
    }

    // ================= TM1637 STRING (digits + letters e.g. Open) =================
    if (cmd.startsWith("TM1637_STRING")) {
      char data[10];
      if (sscanf(cmd.c_str(), "TM1637_STRING %s", data) == 1 && tm1637Display != nullptr) {
        int len = (int)strlen(data);
        if (len > 4) len = 4;
        for (int i = 0; i < len; i++) {
          uint8_t seg = tm1637SegmentForChar(data[i]);
          tm1637Segments[i] = seg;
          tm1637Display->setSegments(&seg, 1, i);
        }
        tm1637HasLastNumber = false;
        server.send(200, "text/plain", "OK");
      } else {
        server.send(400, "text/plain", "NOT_INITIALIZED");
      }
      return;
    }

    // ================= TM1637 SEGMENTS =================
    if (cmd.startsWith("TM1637_SEGMENTS")) {
      int length, position, consumed = 0;
      int parsed = sscanf(cmd.c_str(), "TM1637_SEGMENTS %d %d %n", &length, &position, &consumed);
      if (parsed == 2 && consumed > 0 && tm1637Display != nullptr) {
        uint8_t values[4] = {0, 0, 0, 0};
        String expressions = cmd.substring(consumed);
        int valueCount = 0;
        while (expressions.length() > 0 && valueCount < 4) {
          int comma = expressions.indexOf(',');
          String item = comma >= 0 ? expressions.substring(0, comma) : expressions;
          values[valueCount++] = tm1637ParseSegmentExpr(item);
          if (comma < 0) break;
          expressions = expressions.substring(comma + 1);
        }
        length = constrain(length, 1, 4);
        if (length > valueCount) length = valueCount;
        position = constrain(position, 0, 3);
        if (position + length > 4) length = 4 - position;
        tm1637Display->setSegments(values, length, position);
        for (int i = 0; i < length; i++) tm1637Segments[position + i] = values[i];
        tm1637HasLastNumber = false;
        server.send(200, "text/plain", "OK");
      } else {
        server.send(400, "text/plain", "INVALID_FORMAT");
      }
      return;
    }

    // ================= TM1637 RAW BIT =================
    if (cmd.startsWith("TM1637_BIT")) {
      int data, pos;
      if (sscanf(cmd.c_str(), "TM1637_BIT %i %d", &data, &pos) == 2 &&
          tm1637Display != nullptr && pos >= 0 && pos < 4) {
        uint8_t segment = (uint8_t)data;
        tm1637Segments[pos] = segment;
        tm1637Display->setSegments(&segment, 1, pos);
        tm1637HasLastNumber = false;
        server.send(200, "text/plain", "OK");
      } else {
        server.send(400, "text/plain", "INVALID_FORMAT");
      }
      return;
    }

    // ================= TM1637 DIGIT =================
    if (cmd.startsWith("TM1637_DIGIT")) {
      int digit, pos;
      if (sscanf(cmd.c_str(), "TM1637_DIGIT %d %d", &digit, &pos) == 2 && tm1637Display != nullptr) {
        uint8_t segment = tm1637Display->encodeDigit(constrain(digit, 0, 9));
        tm1637Segments[constrain(pos, 0, 3)] = segment;
        tm1637Display->setSegments(&segment, 1, constrain(pos, 0, 3));
        tm1637HasLastNumber = false;
        server.send(200, "text/plain", "OK");
      } else {
        server.send(400, "text/plain", "NOT_INITIALIZED");
      }
      return;
    }

    // ================= TM1637 CLEAR =================
    if (cmd.startsWith("TM1637_CLEAR")) {
      if (tm1637Display != nullptr) {
        tm1637Display->clear();
        memset(tm1637Segments, 0, sizeof(tm1637Segments));
        tm1637HasLastNumber = false;
        server.send(200, "text/plain", "OK");
      } else {
        server.send(400, "text/plain", "NOT_INITIALIZED");
      }
      return;
    }

    // ================= TM1637 POINT / COLON =================
    if (cmd.startsWith("TM1637_POINT") || cmd.startsWith("TM1637_COLON")) {
      char state[10];
      int parsed = cmd.startsWith("TM1637_POINT")
        ? sscanf(cmd.c_str(), "TM1637_POINT %s", state)
        : sscanf(cmd.c_str(), "TM1637_COLON %s", state);
      if (parsed == 1 && tm1637Display != nullptr) {
        bool pointOn = strcmp(state, "true") == 0 || strcmp(state, "on") == 0 || strcmp(state, "1") == 0;
        tm1637Dots = pointOn ? 0x40 : 0;
        if (tm1637HasLastNumber) {
          tm1637Display->showNumberDecEx(
            tm1637LastNumber, tm1637Dots, tm1637LastLeadingZeros,
            tm1637LastLength, tm1637LastPosition
          );
        }
        server.send(200, "text/plain", "OK");
      } else {
        server.send(400, "text/plain", "NOT_INITIALIZED");
      }
      return;
    }

    if (cmd.startsWith("TM1637_SHOW_TIME")) {
      int hour, minute;
      if (sscanf(cmd.c_str(), "TM1637_SHOW_TIME %d %d", &hour, &minute) == 2 && tm1637Display != nullptr) {
        hour = constrain(hour, 0, 99);
        minute = constrain(minute, 0, 99);
        int value = hour * 100 + minute;
        tm1637Dots = 0x40;
        tm1637Display->showNumberDecEx(value, tm1637Dots, true, 4, 0);
        tm1637LastNumber = value;
        tm1637LastLength = 4;
        tm1637LastPosition = 0;
        tm1637LastLeadingZeros = true;
        tm1637HasLastNumber = true;
        server.send(200, "text/plain", "OK");
      } else {
        server.send(400, "text/plain", "NOT_INITIALIZED");
      }
      return;
    }

    if (cmd.startsWith("TM1637_SET_SEGMENTS")) {
      int length, position, s0 = 0, s1 = 0, s2 = 0, s3 = 0;
      int parsed = sscanf(cmd.c_str(), "TM1637_SET_SEGMENTS %d %d %d %d %d %d",
        &length, &position, &s0, &s1, &s2, &s3);
      if (parsed >= 3 && tm1637Display != nullptr) {
        uint8_t values[4] = { (uint8_t)s0, (uint8_t)s1, (uint8_t)s2, (uint8_t)s3 };
        length = constrain(length, 1, 4);
        if (length > parsed - 2) length = parsed - 2;
        if (length < 1) length = 1;
        position = constrain(position, 0, 3);
        if (position + length > 4) length = 4 - position;
        tm1637Display->setSegments(values, length, position);
        for (int i = 0; i < length; i++) tm1637Segments[position + i] = values[i];
        tm1637HasLastNumber = false;
        server.send(200, "text/plain", "OK");
      } else {
        server.send(400, "text/plain", "INVALID_FORMAT");
      }
      return;
    }

    // ================= DHT INIT =================
    if (cmd.startsWith("DHT_INIT")) {
      int no = 1, pin = -1, model = 11;
      char modelStr[16];
      if (sscanf(cmd.c_str(), "DHT_INIT %d %d %15s", &no, &pin, modelStr) == 3) {
        model = dhtParseModel(modelStr);
      } else if (sscanf(cmd.c_str(), "DHT_INIT %d %d", &pin, &model) == 2) {
        no = 1;
      } else {
        server.send(400, "text/plain", "INVALID_FORMAT");
        return;
      }
      if (no >= 0 && no <= 4 && pin >= 0) {
        dhtPins[no] = (uint8_t)pin;
        dhtTypes[no] = (uint8_t)model;
        dhtLastTemp[no] = NAN;
        dhtLastHum[no] = NAN;
        if (dhtSensors[no] != nullptr) delete dhtSensors[no];
        dhtSensors[no] = new DHT(pin, model);
        dhtSensors[no]->begin();
        pinMode(pin, INPUT_PULLUP);
        server.send(200, "text/plain", "OK");
      } else {
        server.send(400, "text/plain", "INVALID_FORMAT");
      }
      return;
    }

    // ================= DHT READ TEMPERATURE =================
    if (cmd.startsWith("DHT_READ_TEMP") || cmd.startsWith("DHT_TEMP")) {
      int no = 1, isFahrenheit = 0;
      if (cmd.startsWith("DHT_READ_TEMP")) {
        sscanf(cmd.c_str(), "DHT_READ_TEMP %d %d", &no, &isFahrenheit);
      } else {
        sscanf(cmd.c_str(), "DHT_TEMP %d", &no);
      }
      float tempC = NAN, hum = NAN;
      if (dhtReadSlot(no, &tempC, &hum)) {
        float temp = isFahrenheit ? (tempC * 9.0f / 5.0f + 32.0f) : tempC;
        server.send(200, "text/plain", String(temp, 2));
      } else if (no < 0 || no > 4 || dhtPins[no] == 255) {
        server.send(400, "text/plain", "NOT_INITIALIZED");
      } else {
        server.send(400, "text/plain", "READ_ERROR");
      }
      return;
    }

    // ================= DHT READ HUMIDITY =================
    if (cmd.startsWith("DHT_READ_HUM") || cmd.startsWith("DHT_HUM")) {
      int no = 1;
      sscanf(cmd.c_str(), "%*s %d", &no);
      float tempC = NAN, hum = NAN;
      if (dhtReadSlot(no, &tempC, &hum)) {
        server.send(200, "text/plain", String(hum, 2));
      } else if (no < 0 || no > 4 || dhtPins[no] == 255) {
        server.send(400, "text/plain", "NOT_INITIALIZED");
      } else {
        server.send(400, "text/plain", "READ_ERROR");
      }
      return;
    }

    // ================= ULTRASONIC INIT / READ =================
    if (cmd.startsWith("ULTRASONIC_INIT")) {
      int no, trig, echo;
      if (sscanf(cmd.c_str(), "ULTRASONIC_INIT %d %d %d", &no, &trig, &echo) == 3) {
        ultrasonicTrig = trig;
        ultrasonicEcho = echo;
        pinMode(trig, OUTPUT);
        pinMode(echo, INPUT);
        server.send(200, "text/plain", "OK");
      } else {
        server.send(400, "text/plain", "INVALID_FORMAT");
      }
      return;
    }

    if (cmd.startsWith("ULTRASONIC_READ")) {
      int trig, echo, isInch;
      if (sscanf(cmd.c_str(), "ULTRASONIC_READ %d %d %d", &trig, &echo, &isInch) == 3) {
        pinMode(trig, OUTPUT);
        pinMode(echo, INPUT);
        digitalWrite(trig, LOW);
        delayMicroseconds(2);
        digitalWrite(trig, HIGH);
        delayMicroseconds(10);
        digitalWrite(trig, LOW);
        long duration = pulseIn(echo, HIGH, 30000UL);
        float distance = duration * (isInch ? 0.0133 : 0.034) / 2.0;
        server.send(200, "text/plain", String("ULTRASONIC_DIST ") + String(distance, 2));
      } else {
        server.send(400, "text/plain", "INVALID_FORMAT");
      }
      return;
    }

    // ================= TCS34725 INIT =================
    if (cmd.startsWith("TCS34725_INIT")) {
      if (tcs34725 == nullptr) {
        tcs34725 = new Adafruit_TCS34725(TCS34725_INTEGRATIONTIME_50MS, TCS34725_GAIN_4X);
        if (tcs34725->begin()) {
          server.send(200, "text/plain", "OK");
        } else {
          server.send(400, "text/plain", "INIT_FAILED");
        }
      } else {
        server.send(200, "text/plain", "OK");
      }
      return;
    }

    // ================= TCS34725 READ =================
    if (cmd.startsWith("TCS34725_READ")) {
      if (tcs34725 != nullptr) {
        tcs34725Update();
        server.send(200, "text/plain", "OK");
      } else {
        server.send(400, "text/plain", "NOT_INITIALIZED");
      }
      return;
    }

    // ================= TCS34725 LED =================
    if (cmd.startsWith("TCS34725_LED")) {
      char state[8];
      if (sscanf(cmd.c_str(), "TCS34725_LED %s", state) == 1 && tcs34725 != nullptr) {
        bool ledOn = strcmp(state, "ON") == 0 || strcmp(state, "on") == 0 || strcmp(state, "1") == 0;
        tcs34725->setInterrupt(!ledOn);
        server.send(200, "text/plain", "OK");
      } else {
        server.send(400, "text/plain", "NOT_INITIALIZED");
      }
      return;
    }

    // ================= TCS34725 COLOR TEMPERATURE =================
    if (cmd.startsWith("TCS34725_COLOR_TEMP")) {
      if (tcs34725 != nullptr) {
        tcs34725Update();
        uint16_t value = tcs34725->calculateColorTemperature_dn40(
          tcs34725Color[0], tcs34725Color[1], tcs34725Color[2], tcs34725Color[3]
        );
        server.send(200, "text/plain", String(value));
      } else {
        server.send(400, "text/plain", "NOT_INITIALIZED");
      }
      return;
    }

    // ================= TCS34725 LUX =================
    if (cmd.startsWith("TCS34725_LUX")) {
      if (tcs34725 != nullptr) {
        tcs34725Update();
        uint16_t value = tcs34725->calculateLux(
          tcs34725Color[0], tcs34725Color[1], tcs34725Color[2]
        );
        server.send(200, "text/plain", String(value));
      } else {
        server.send(400, "text/plain", "NOT_INITIALIZED");
      }
      return;
    }

    // ================= TCS34725 DETECTED COLOR NAME =================
    if (cmd.startsWith("TCS34725_GET_NAME") || cmd.startsWith("COLOUR_NAME")) {
      if (tcs34725 != nullptr) {
        server.send(200, "text/plain", tcs34725DetectColour());
      } else {
        server.send(400, "text/plain", "NOT_INITIALIZED");
      }
      return;
    }

    if (cmd.startsWith("TCS34725_GET_RGB")) {
      if (tcs34725 != nullptr) {
        tcs34725Update();
        uint16_t c = tcs34725Color[3] == 0 ? 1 : tcs34725Color[3];
        int r = constrain((int)((float)tcs34725Color[0] / c * 255.0f), 0, 255);
        int g = constrain((int)((float)tcs34725Color[1] / c * 255.0f), 0, 255);
        int b = constrain((int)((float)tcs34725Color[2] / c * 255.0f), 0, 255);
        server.send(200, "text/plain", "RGB " + String(r) + " " + String(g) + " " + String(b));
      } else {
        server.send(400, "text/plain", "NOT_INITIALIZED");
      }
      return;
    }

    // ================= TCS34725 GET COLOR =================
    if (cmd.startsWith("TCS34725_GET_COLOR")) {
      if (tcs34725 != nullptr) {
        char colorType[16];
        int n = sscanf(cmd.c_str(), "TCS34725_GET_COLOR %15s", colorType);
        if (n != 1 || strlen(colorType) > 1) {
          server.send(200, "text/plain", tcs34725DetectColour());
        } else {
          tcs34725Update();
          int value = 0;
          if (colorType[0] == 'R' || colorType[0] == 'r') value = tcs34725Color[0];
          else if (colorType[0] == 'G' || colorType[0] == 'g') value = tcs34725Color[1];
          else if (colorType[0] == 'B' || colorType[0] == 'b') value = tcs34725Color[2];
          else if (colorType[0] == 'C' || colorType[0] == 'c') value = tcs34725Color[3];
          else {
            server.send(200, "text/plain", tcs34725DetectColour());
            return;
          }
          server.send(200, "text/plain", String(value));
        }
      } else {
        server.send(400, "text/plain", "NOT_INITIALIZED");
      }
      return;
    }

    // ================= TCS34725 IS COLOR =================
    if (cmd.startsWith("TCS34725_IS_COLOR")) {
      char targetColor[10];
      if (sscanf(cmd.c_str(), "TCS34725_IS_COLOR %s", targetColor) == 1 && tcs34725 != nullptr) {
        String detected = tcs34725DetectColour();
        String target = String(targetColor);
        target.toUpperCase();
        bool isColor = detected == target;
        server.send(200, "text/plain", isColor ? "1" : "0");
      } else {
        server.send(400, "text/plain", "NOT_INITIALIZED");
      }
      return;
    }

    if (cmd.startsWith("TCS3200_INIT")) {
      int s0, s1, s2, s3, p5, p6 = -1;
      int n = sscanf(cmd.c_str(), "TCS3200_INIT %d %d %d %d %d %d", &s0, &s1, &s2, &s3, &p5, &p6);
      if (n >= 5) {
        tcs3200S0 = s0; tcs3200S1 = s1; tcs3200S2 = s2; tcs3200S3 = s3;
        tcs3200Out = (n >= 6) ? p6 : p5;
        tcs3200Oe = (n >= 6) ? p5 : -1;
        pinMode(tcs3200S0, OUTPUT); pinMode(tcs3200S1, OUTPUT);
        pinMode(tcs3200S2, OUTPUT); pinMode(tcs3200S3, OUTPUT);
        pinMode(tcs3200Out, INPUT);
        digitalWrite(tcs3200S0, HIGH);
        digitalWrite(tcs3200S1, HIGH);
        if (tcs3200Oe >= 0) { pinMode(tcs3200Oe, OUTPUT); digitalWrite(tcs3200Oe, LOW); }
        tcs3200Ready = true;
        server.send(200, "text/plain", "OK");
      } else {
        server.send(400, "text/plain", "INVALID_FORMAT");
      }
      return;
    }

    if (cmd.startsWith("TCS3200_CALIBRATE_WHITE")) {
      if (!tcs3200Ready) { server.send(400, "text/plain", "NOT_INITIALIZED"); return; }
      tcs3200MeasureRaw();
      tcs3200White[0] = tcs3200Last[0]; tcs3200White[1] = tcs3200Last[1]; tcs3200White[2] = tcs3200Last[2];
      server.send(200, "text/plain", "OK");
      return;
    }

    if (cmd.startsWith("TCS3200_CALIBRATE_BLACK")) {
      if (!tcs3200Ready) { server.send(400, "text/plain", "NOT_INITIALIZED"); return; }
      tcs3200MeasureRaw();
      tcs3200Black[0] = tcs3200Last[0]; tcs3200Black[1] = tcs3200Last[1]; tcs3200Black[2] = tcs3200Last[2];
      server.send(200, "text/plain", "OK");
      return;
    }

    if (cmd.startsWith("TCS3200_MEASURE")) {
      if (!tcs3200Ready) { server.send(400, "text/plain", "NOT_INITIALIZED"); return; }
      tcs3200MeasureRaw();
      server.send(200, "text/plain", "OK");
      return;
    }

    if (cmd.startsWith("TCS3200_GET_COLOR") || cmd.startsWith("TCS3200_RED") ||
        cmd.startsWith("TCS3200_GREEN") || cmd.startsWith("TCS3200_BLUE") ||
        cmd.startsWith("TCS3200_RGB")) {
      if (!tcs3200Ready) { server.send(400, "text/plain", "NOT_INITIALIZED"); return; }
      tcs3200MeasureRaw();
      int r = tcs3200MapChannel(0), g = tcs3200MapChannel(1), b = tcs3200MapChannel(2);
      if (cmd.startsWith("TCS3200_RGB")) {
        server.send(200, "text/plain", String(r) + " " + String(g) + " " + String(b));
      } else {
        char which[12] = "R";
        sscanf(cmd.c_str(), "TCS3200_GET_COLOR %11s", which);
        if (cmd.startsWith("TCS3200_GREEN") || which[0] == 'G' || which[0] == 'g') r = g;
        else if (cmd.startsWith("TCS3200_BLUE") || which[0] == 'B' || which[0] == 'b') r = b;
        else if (cmd.startsWith("TCS3200_RED") || which[0] == 'R' || which[0] == 'r') { /* r */ }
        server.send(200, "text/plain", String(r));
      }
      return;
    }

    // ================= MATRIX 8x8 INIT (MAX7219 SPI) =================
    if (cmd.startsWith("MATRIX8X8_INIT")) {
      int cs;
      if (sscanf(cmd.c_str(), "MATRIX8X8_INIT %d", &cs) == 1) {
        matrix8x8_cs_pin = cs;
        pinMode(matrix8x8_cs_pin, OUTPUT);
        digitalWrite(matrix8x8_cs_pin, HIGH);

        // Initialize SPI
        SPI.begin();

        // Initialize MAX7219
        max7219_send(MAX7219_REG_SHUTDOWN, 0x01);    // Turn on
        max7219_send(MAX7219_REG_DECODEMODE, 0x00);  // No decoding
        max7219_send(MAX7219_REG_SCANLIMIT, 0x07);   // Scan all digits
        max7219_send(MAX7219_REG_INTENSITY, 0x07);   // Medium brightness
        max7219_send(MAX7219_REG_DISPLAYTEST, 0x00); // Normal operation

        // Clear display
        for (int i = 0; i < 8; i++) {
          matrix8x8_buffer[i] = 0;
          max7219_send(MAX7219_REG_DIGIT0 + i, 0);
        }

        server.send(200, "text/plain", "OK");
      } else {
        server.send(400, "text/plain", "INVALID_FORMAT");
      }
      return;
    }

    // ================= MATRIX 8x8 PIXEL =================
    if (cmd.startsWith("MATRIX8X8_PIXEL")) {
      int x, y, color;
      if (sscanf(cmd.c_str(), "MATRIX8X8_PIXEL %d %d %d", &x, &y, &color) == 3 && matrix8x8_cs_pin >= 0) {
        if (x >= 0 && x < 8 && y >= 0 && y < 8) {
          if (color != 0) {
            matrix8x8_buffer[y] |= (1 << (7 - x));  // Set bit
          } else {
            matrix8x8_buffer[y] &= ~(1 << (7 - x)); // Clear bit
          }
          max7219_send(MAX7219_REG_DIGIT0 + y, matrix8x8_buffer[y]);
          server.send(200, "text/plain", "OK");
        } else {
          server.send(400, "text/plain", "OUT_OF_RANGE");
        }
      } else {
        server.send(400, "text/plain", "NOT_INITIALIZED");
      }
      return;
    }

    // ================= MATRIX 8x8 CLEAR =================
    if (cmd.startsWith("MATRIX8X8_CLEAR")) {
      if (matrix8x8_cs_pin >= 0) {
        for (int i = 0; i < 8; i++) {
          matrix8x8_buffer[i] = 0;
          max7219_send(MAX7219_REG_DIGIT0 + i, 0);
        }
        server.send(200, "text/plain", "OK");
      } else {
        server.send(400, "text/plain", "NOT_INITIALIZED");
      }
      return;
    }

    // ================= MATRIX 8x8 FILL =================
    if (cmd.startsWith("MATRIX8X8_FILL")) {
      int color;
      if (sscanf(cmd.c_str(), "MATRIX8X8_FILL %d", &color) == 1 && matrix8x8_cs_pin >= 0) {
        for (int i = 0; i < 8; i++) {
          matrix8x8_buffer[i] = (color != 0) ? 0xFF : 0x00;
          max7219_send(MAX7219_REG_DIGIT0 + i, matrix8x8_buffer[i]);
        }
        server.send(200, "text/plain", "OK");
      } else {
        server.send(400, "text/plain", "NOT_INITIALIZED");
      }
      return;
    }

    // ================= MATRIX 8x8 BRIGHTNESS =================
    if (cmd.startsWith("MATRIX8X8_BRIGHTNESS")) {
      int brt;
      if (sscanf(cmd.c_str(), "MATRIX8X8_BRIGHTNESS %d", &brt) == 1 && matrix8x8_cs_pin >= 0) {
        int intensity = constrain(brt, 0, 15);
        max7219_send(MAX7219_REG_INTENSITY, intensity);
        server.send(200, "text/plain", "OK");
      } else {
        server.send(400, "text/plain", "NOT_INITIALIZED");
      }
      return;
    }

    // ================= MATRIX 8x8 PATTERN =================
    if (cmd.startsWith("MATRIX8X8_PATTERN")) {
      char pattern[9];
      if (sscanf(cmd.c_str(), "MATRIX8X8_PATTERN %s", pattern) == 1 && matrix8x8_cs_pin >= 0) {
        for (int i = 0; i < 8 && i < strlen(pattern); i++) {
          uint8_t row = 0;
          for (int j = 0; j < 8; j++) {
            if (pattern[i] & (1 << j)) {
              row |= (1 << (7 - j));
            }
          }
          matrix8x8_buffer[i] = row;
          max7219_send(MAX7219_REG_DIGIT0 + i, row);
        }
        server.send(200, "text/plain", "OK");
      } else {
        server.send(400, "text/plain", "NOT_INITIALIZED");
      }
      return;
    }

    // ================= LED MATRIX INIT (NeoPixel 5x7) =================
    if (cmd.startsWith("LEDMATRIX_INIT")) {
      int pin, num, brt;
      if (sscanf(cmd.c_str(), "LEDMATRIX_INIT %d %d %d", &pin, &num, &brt) == 3) {
        if (ledMatrixStrip != nullptr) { delete ledMatrixStrip; }
        int n = (num > 0 && num <= 256) ? num : LEDMATRIX_LEDS;
        ledMatrixStrip = new Adafruit_NeoPixel(n, pin, NEO_GRB + NEO_KHZ800);
        ledMatrixStrip->begin();
        ledMatrixStrip->setBrightness(constrain(brt, 0, 255));
        ledMatrixStrip->show();
        server.send(200, "text/plain", "OK");
      } else {
        server.send(400, "text/plain", "INVALID_FORMAT");
      }
      return;
