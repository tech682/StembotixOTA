// ---------- WiFi for Blockzie + OTA ----------
// Default WiFi: used only if no WiFi was saved on the STEMbotix-Setup hotspot.
const char* DEFAULT_SSID = "YOUR_WIFI_NAME";
const char* DEFAULT_PASS = "YOUR_WIFI_PASSWORD";

const char* ssid = DEFAULT_SSID;       // what Blockzie connects with (set by loadWiFiCredentials)
const char* password = DEFAULT_PASS;
String savedSsid, savedPass;

// Use the WiFi saved by the OTA library's setup hotspot, so Blockzie and OTA
// always use the same network. Falls back to DEFAULT_SSID / DEFAULT_PASS.
void loadWiFiCredentials() {
  Preferences p;
  if (p.begin("ota", true)) {            // same storage the OTA library uses
    savedSsid = p.getString("ssid", "");
    savedPass = p.getString("pass", "");
    p.end();
  }
  if (savedSsid.length()) {
    ssid = savedSsid.c_str();
    password = savedPass.c_str();
    Serial.printf("Using WiFi saved on the setup hotspot: %s\n", ssid);
  } else {
    Serial.printf("Using default WiFi: %s\n", ssid);
  }
}

WebServer server(80);

// Runs once when OTA mode starts: stop the Blockzie server so port 80 is free
// (the WiFi setup hotspot needs it) and Blockzie commands stop arriving.
void stopBlockzie() {
  server.stop();
}
