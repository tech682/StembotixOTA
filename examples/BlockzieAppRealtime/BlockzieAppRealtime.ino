          int sp2 = rest.indexOf(' ');
          if (sp2 > 0) {
            String text = rest.substring(sp2 + 1);
            text.trim();
            lcdWriteText(text);
            server.send(200, "text/plain", "OK");
            return;
          }
        }
        server.send(400, "text/plain", "INVALID_FORMAT");
