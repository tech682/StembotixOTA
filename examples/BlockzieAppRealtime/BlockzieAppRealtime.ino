// DHT Sensors (slots 0-4 so Blockly sensor 1..4 all work)
DHT* dhtSensors[5] = {nullptr, nullptr, nullptr, nullptr, nullptr};
uint8_t dhtPins[5] = {255, 255, 255, 255, 255};
uint8_t dhtTypes[5] = {0, 0, 0, 0, 0};
float dhtLastTemp[5] = {NAN, NAN, NAN, NAN, NAN};
float dhtLastHum[5] = {NAN, NAN, NAN, NAN, NAN};
unsigned long dhtLastOkMs[5] = {0, 0, 0, 0, 0};

bool dhtSample(uint8_t pin, uint8_t type, float* tempC, float* hum) {
  uint8_t data[5] = {0, 0, 0, 0, 0};
  pinMode(pin, OUTPUT);
  digitalWrite(pin, LOW);
  delay(type == 11 ? 20 : 2);
  digitalWrite(pin, HIGH);
  delayMicroseconds(30);
  pinMode(pin, INPUT_PULLUP);
  if (pulseIn(pin, HIGH, 1000) == 0) return false;
  for (int i = 0; i < 40; i++) {
    unsigned long dur = pulseIn(pin, HIGH, 1000);
    if (dur == 0) return false;
    data[i / 8] <<= 1;
    if (dur > 40) data[i / 8] |= 1;
  }
  if (data[4] != (uint8_t)(data[0] + data[1] + data[2] + data[3])) return false;
  if (type == 11) {
    *hum = data[0];
    *tempC = data[2];
  } else {
    *hum = ((data[0] << 8) | data[1]) * 0.1f;
    *tempC = (((data[2] & 0x7F) << 8) | data[3]) * 0.1f;
    if (data[2] & 0x80) *tempC = -*tempC;
  }
  return true;
}

bool dhtReadSlot(int no, float* tempC, float* hum) {
  if (no < 0 || no > 4 || dhtPins[no] == 255) return false;
  for (int attempt = 0; attempt < 3; attempt++) {
    if (dhtSample(dhtPins[no], dhtTypes[no], tempC, hum)) {
      dhtLastTemp[no] = *tempC;
      dhtLastHum[no] = *hum;
      dhtLastOkMs[no] = millis();
      return true;
    }
    delay(60);
  }
  if (!isnan(dhtLastTemp[no]) && (millis() - dhtLastOkMs[no]) < 5000UL) {
    *tempC = dhtLastTemp[no];
    *hum = dhtLastHum[no];
    return true;
  }
  return false;
}

int dhtParseModel(const char* s) {
  if (!s || !s[0]) return 11;
  if (s[0] >= '0' && s[0] <= '9') return atoi(s);
  if (strstr(s, "22") || strstr(s, "AM2302")) return 22;
  if (strstr(s, "21") || strstr(s, "AM2301")) return 21;
  return 11;
}

// TM1637 Display
TM1637Display* tm1637Display = nullptr;
uint8_t tm1637Segments[4] = {0, 0, 0, 0};
uint8_t tm1637Dots = 0;
int tm1637LastNumber = 0;
int tm1637LastLength = 4;
int tm1637LastPosition = 0;
bool tm1637LastLeadingZeros = false;
bool tm1637HasLastNumber = false;
// 7-segment segment map for digits and common letters (A,B,C... O,P,E,n etc.)
uint8_t tm1637SegmentForChar(char c) {
  if (c >= '0' && c <= '9') return tm1637Display->encodeDigit(c - '0');
  switch ((char)toupper((int)c)) {
    case 'A': return 0x77; case 'B': return 0x7C; case 'C': return 0x39;
    case 'D': return 0x5E; case 'E': return 0x79; case 'F': return 0x71;
    case 'G': return 0x3D; case 'H': return 0x76; case 'I': return 0x30;
    case 'J': return 0x1E; case 'L': return 0x38; case 'N': return 0x54;
    case 'O': return 0x3F; case 'P': return 0x73; case 'Q': return 0x67;
    case 'R': return 0x50; case 'S': return 0x6D; case 'T': return 0x78;
    case 'U': return 0x3E; case 'Y': return 0x6E; case 'Z': return 0x5B;
    default: return 0x00;
  }
  return 0x00;
}

uint8_t tm1637ParseSegmentExpr(String expression) {
  expression.trim();
  if (expression.indexOf("SEG_") >= 0) {
    uint8_t value = 0;
    if (expression.indexOf("SEG_A") >= 0) value |= SEG_A;
    if (expression.indexOf("SEG_B") >= 0) value |= SEG_B;
    if (expression.indexOf("SEG_C") >= 0) value |= SEG_C;
    if (expression.indexOf("SEG_D") >= 0) value |= SEG_D;
    if (expression.indexOf("SEG_E") >= 0) value |= SEG_E;
    if (expression.indexOf("SEG_F") >= 0) value |= SEG_F;
    if (expression.indexOf("SEG_G") >= 0) value |= SEG_G;
    if (expression.indexOf("SEG_DP") >= 0) value |= SEG_DP;
    return value;
  }
  return (uint8_t)strtol(expression.c_str(), nullptr, 0);
}

// TCS34725 Color Sensor (I2C)
Adafruit_TCS34725* tcs34725 = nullptr;
uint16_t tcs34725Color[4] = {0, 0, 0, 0}; // R, G, B, C

void tcs34725Update() {
  if (tcs34725 != nullptr) {
    tcs34725->getRawData(
      &tcs34725Color[0], &tcs34725Color[1],
      &tcs34725Color[2], &tcs34725Color[3]
    );
  }
}

String tcs34725DetectColour() {
  tcs34725Update();
  uint16_t c = tcs34725Color[3];
  if (c < 50) return "BLACK";
  float r = (float)tcs34725Color[0] / c * 255.0f;
  float g = (float)tcs34725Color[1] / c * 255.0f;
  float b = (float)tcs34725Color[2] / c * 255.0f;
  if (r > 180 && g > 180 && b > 180) return "WHITE";
  if (r > 120 && g > 100 && b < 100 && (r - b) > 40 && (g - b) > 30) return "YELLOW";
  if (r >= g && r >= b && (r - g) > 15) return "RED";
  if (g >= r && g >= b && (g - r) > 15) return "GREEN";
  if (b >= r && b >= g && (b - r) > 15) return "BLUE";
  if (g >= r && g >= b) return "GREEN";
  if (r >= g && r >= b) return "RED";
  return "BLUE";
}

int tcs3200S0 = -1, tcs3200S1 = -1, tcs3200S2 = -1, tcs3200S3 = -1, tcs3200Out = -1, tcs3200Oe = -1;
unsigned long tcs3200White[3] = {1, 1, 1};
unsigned long tcs3200Black[3] = {1, 1, 1};
unsigned long tcs3200Last[3] = {0, 0, 0};
bool tcs3200Ready = false;

unsigned long tcs3200Pulse(bool s2, bool s3) {
  if (tcs3200Out < 0) return 0;
  digitalWrite(tcs3200S2, s2 ? HIGH : LOW);
  digitalWrite(tcs3200S3, s3 ? HIGH : LOW);
  delay(8);
  return pulseIn(tcs3200Out, LOW, 80000UL);
}

void tcs3200MeasureRaw() {
  tcs3200Last[0] = tcs3200Pulse(false, false);
  tcs3200Last[1] = tcs3200Pulse(true, true);
  tcs3200Last[2] = tcs3200Pulse(false, true);
}

int tcs3200MapChannel(int i) {
  unsigned long lo = tcs3200White[i];
  unsigned long hi = tcs3200Black[i];
  unsigned long v = tcs3200Last[i];
  if (hi == lo) return 0;
  if (hi < lo) { unsigned long tmp = hi; hi = lo; lo = tmp; }
  long mapped = map((long)v, (long)lo, (long)hi, 255, 0);
  return (int)constrain(mapped, 0, 255);
}

// SSD1306 OLED
Adafruit_SSD1306* oledDisplay = nullptr;
bool oledReady = false;

bool oledDoInit(int width, int height, int address, int powerMode) {
  if (oledDisplay != nullptr) {
    delete oledDisplay;
    oledDisplay = nullptr;
  }
  oledDisplay = new Adafruit_SSD1306(width, height, &Wire, -1, 100000UL, 100000UL);
  Wire.begin();
  Wire.setClock(100000L);
  delay(100);
  bool ok = oledDisplay->begin(powerMode, address);
  if (!ok) ok = oledDisplay->begin(powerMode, address == 0x3D ? 0x3C : 0x3D);
  if (!ok) {
    delete oledDisplay;
    oledDisplay = nullptr;
    oledReady = false;
    return false;
  }
  oledDisplay->clearDisplay();
  oledDisplay->setTextSize(1);
  oledDisplay->setTextColor(SSD1306_WHITE);
  oledDisplay->cp437(true);
  oledDisplay->setCursor(0, 0);
  oledDisplay->display();
  oledReady = true;
  return true;
}

void oledRefresh() {
  if (oledReady && oledDisplay != nullptr) oledDisplay->display();
}

uint16_t oledColorFromText(const char* value) {
  if (!strcasecmp(value, "light") || !strcasecmp(value, "white") ||
      !strcasecmp(value, "SSD1306_WHITE") || !strcmp(value, "1")) {
    return SSD1306_WHITE;
  }
  if (!strcasecmp(value, "inverse") || !strcasecmp(value, "SSD1306_INVERSE") ||
      !strcmp(value, "2")) {
    return SSD1306_INVERSE;
  }
  return SSD1306_BLACK;
}

bool oledSetFontByName(const char* font) {
  if (oledDisplay == nullptr) return false;
  oledDisplay->setFont();
  return true;
}

