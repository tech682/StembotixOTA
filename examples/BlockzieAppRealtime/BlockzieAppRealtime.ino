      if (sscanf(cmd.c_str(), "PS2_DIRECTION %d %d %d %d %d", &xPin, &yPin, &cx, &cy, &dz) == 5) {
        int x = analogRead(xPin);
        int y = analogRead(yPin);
        server.send(200, "text/plain", ps2DirectionFrom(x, y, cx, cy, dz));
      } else {
        server.send(400, "text/plain", "INVALID_FORMAT");
      }
      return;
    }

    if (cmd.startsWith("PS2_ANGLE")) {
      int xPin, yPin, cx, cy, dz;
      if (sscanf(cmd.c_str(), "PS2_ANGLE %d %d %d %d %d", &xPin, &yPin, &cx, &cy, &dz) == 5) {
        int dx = analogRead(xPin) - cx;
        int dy = analogRead(yPin) - cy;
        if (abs(dx) <= dz && abs(dy) <= dz) {
          server.send(200, "text/plain", "0");
        } else {
          float angle = atan2f((float)dy, (float)dx) * 180.0f / 3.14159265f;
          if (angle < 0) angle += 360.0f;
          server.send(200, "text/plain", String((int)(angle + 0.5f)));
        }
      } else {
        server.send(400, "text/plain", "INVALID_FORMAT");
      }
      return;
    }

    if (cmd.startsWith("PS2_MAGNITUDE")) {
      int xPin, yPin, cx, cy, dz;
      if (sscanf(cmd.c_str(), "PS2_MAGNITUDE %d %d %d %d %d", &xPin, &yPin, &cx, &cy, &dz) == 5) {
        float dx = analogRead(xPin) - cx;
        float dy = analogRead(yPin) - cy;
        float mag = sqrtf(dx * dx + dy * dy);
        int pct = constrain((int)(mag / 2047.0f * 100.0f + 0.5f), 0, 100);
        if (mag < dz) pct = 0;
        server.send(200, "text/plain", String(pct));
      } else {
        server.send(400, "text/plain", "INVALID_FORMAT");
      }
      return;
    }

    if (cmd.startsWith("JOY_CONT_SERVO")) {
      int servoPin, analogPin, minA, maxA, dz, speed;
      if (sscanf(cmd.c_str(), "JOY_CONT_SERVO %d %d %d %d %d %d",
          &servoPin, &analogPin, &minA, &maxA, &dz, &speed) == 6) {
        int raw = analogRead(analogPin);
        int center = JOYSTICK_ADC_MAX / 2;
        int target;
        if (abs(raw - center) <= dz) target = (minA + maxA) / 2;
        else target = map(constrain(raw, 0, JOYSTICK_ADC_MAX), 0, JOYSTICK_ADC_MAX, minA, maxA);
        int step = max(1, speed);
        if (target > joyContLastAngle) joyContLastAngle = min(target, joyContLastAngle + step);
        else if (target < joyContLastAngle) joyContLastAngle = max(target, joyContLastAngle - step);
        __blockly_servo__.attach(servoPin);
        __blockly_servo__.write(joyContLastAngle);
        server.send(200, "text/plain", "OK");
      } else {
        server.send(400, "text/plain", "INVALID_FORMAT");
      }
      return;
    }

    if (cmd.startsWith("SERIAL_BEGIN")) {
      int no, baud;
      if (sscanf(cmd.c_str(), "SERIAL_BEGIN %d %d", &no, &baud) == 2) {
        wifiSerialPort(no)->begin(baud);
        server.send(200, "text/plain", "OK");
      } else {
        server.send(400, "text/plain", "INVALID_FORMAT");
      }
      return;
    }

    if (cmd.startsWith("SERIAL_PRINT")) {
      int no;
      int consumed = 0;
      if (sscanf(cmd.c_str(), "SERIAL_PRINT %d %n", &no, &consumed) >= 1 && consumed > 0) {
        String rest = cmd.substring(consumed);
        rest.trim();
        int lastSp = rest.lastIndexOf(' ');
        String value = rest;
        String eol = "warp";
        if (lastSp >= 0) {
          eol = rest.substring(lastSp + 1);
          value = rest.substring(0, lastSp);
        }
        if (eol == "warp") wifiSerialPort(no)->println(value);
        else wifiSerialPort(no)->print(value);
        server.send(200, "text/plain", "OK");
      } else {
        server.send(400, "text/plain", "INVALID_FORMAT");
      }
      return;
    }

    if (cmd.startsWith("SERIAL_AVAILABLE")) {
      int no;
      if (sscanf(cmd.c_str(), "SERIAL_AVAILABLE %d", &no) == 1) {
        server.send(200, "text/plain", String(wifiSerialPort(no)->available()));
      } else {
        server.send(400, "text/plain", "INVALID_FORMAT");
      }
      return;
    }

    if (cmd.startsWith("SERIAL_READ_BYTE")) {
      int no;
      if (sscanf(cmd.c_str(), "SERIAL_READ_BYTE %d", &no) == 1) {
        HardwareSerial* port = wifiSerialPort(no);
        int b = port->available() ? port->read() : -1;
        server.send(200, "text/plain", String(b));
      } else {
        server.send(400, "text/plain", "INVALID_FORMAT");
      }
      return;
    }

    if (cmd.startsWith("SERIAL_READ_STRING")) {
      int no;
      if (sscanf(cmd.c_str(), "SERIAL_READ_STRING %d", &no) == 1) {
        HardwareSerial* port = wifiSerialPort(no);
        String s = port->readString();
        s.trim();
        server.send(200, "text/plain", s);
      } else {
        server.send(400, "text/plain", "INVALID_FORMAT");
      }
      return;
    }

    // ================= VOLTAGE / CURRENT =================
    if (cmd.startsWith("VOLTAGE_INIT")) {
      char pinText[12], refText[16];
      if (sscanf(cmd.c_str(), "VOLTAGE_INIT %11s %15s", pinText, refText) == 2) {
        voltagePin = parseWifiPin(pinText);
        voltageReference = String(refText).toFloat();
        if (voltageReference <= 0) voltageReference = WIFI_ADC_VREF;
        pinMode(voltagePin, INPUT);
#if defined(ARDUINO_ARCH_ESP32)
        analogReadResolution(12);
        analogSetPinAttenuation(voltagePin, ADC_11db);
#endif
        server.send(200, "text/plain", "OK");
      } else {
        server.send(400, "text/plain", "INVALID_FORMAT");
      }
      return;
    }

    if (cmd.startsWith("VOLTAGE_READ_V")) {
      if (voltagePin < 0) server.send(400, "text/plain", "NOT_INITIALIZED");
      else server.send(200, "text/plain", String(readVoltageVout()));
      return;
    }

    if (cmd.startsWith("VOLTAGE_READ_RAW")) {
      if (voltagePin < 0) server.send(400, "text/plain", "NOT_INITIALIZED");
      else server.send(200, "text/plain", String(analogRead(voltagePin)));
      return;
    }

    if (cmd.startsWith("VOLTAGE_READ")) {
      char pinText[12];
      if (sscanf(cmd.c_str(), "VOLTAGE_READ %11s", pinText) == 1) {
        server.send(200, "text/plain", String(analogRead(parseWifiPin(pinText))));
      } else if (voltagePin >= 0) {
        server.send(200, "text/plain", String(analogRead(voltagePin)));
      } else {
        server.send(400, "text/plain", "INVALID_FORMAT");
      }
      return;
    }

    if (cmd.startsWith("CURRENT_INIT")) {
      char pinText[12], modelText[20];
      if (sscanf(cmd.c_str(), "CURRENT_INIT %11s %19s", pinText, modelText) == 2) {
        currentPin = parseWifiPin(pinText);
        currentSensitivity = currentSensitivityFrom(modelText);
        pinMode(currentPin, INPUT);
#if defined(ARDUINO_ARCH_ESP32)
        analogReadResolution(12);
        analogSetPinAttenuation(currentPin, ADC_11db);
#endif
        server.send(200, "text/plain", "OK");
      } else {
        server.send(400, "text/plain", "INVALID_FORMAT");
      }
      return;
    }

    if (cmd.startsWith("CURRENT_READ_MILLIAMPS")) {
      if (currentPin < 0) server.send(400, "text/plain", "NOT_INITIALIZED");
      else server.send(200, "text/plain", String(readCurrentAmps() * 1000.0f));
      return;
    }

    if (cmd.startsWith("CURRENT_READ_AMPS")) {
      if (currentPin < 0) server.send(400, "text/plain", "NOT_INITIALIZED");
      else server.send(200, "text/plain", String(readCurrentAmps()));
      return;
    }

    if (cmd.startsWith("CURRENT_READ_RAW")) {
      if (currentPin < 0) server.send(400, "text/plain", "NOT_INITIALIZED");
      else server.send(200, "text/plain", String(analogRead(currentPin)));
      return;
    }

    if (cmd.startsWith("CURRENT_READ")) {
      char pinText[12];
      if (sscanf(cmd.c_str(), "CURRENT_READ %11s", pinText) == 1) {
        server.send(200, "text/plain", String(analogRead(parseWifiPin(pinText))));
      } else if (currentPin >= 0) {
        server.send(200, "text/plain", String(analogRead(currentPin)));
      } else {
        server.send(400, "text/plain", "INVALID_FORMAT");
      }
      return;
    }

    // ================= STEPPER INIT =================
    if (cmd.startsWith("STEPPER_INIT")) {
      int dirPin, stepPin, steps;
      if (sscanf(cmd.c_str(), "STEPPER_INIT %d %d %d", &dirPin, &stepPin, &steps) == 3) {
        stepperDirPin = dirPin;
        stepperStepPin = stepPin;
        stepperStepsPerRev = (steps > 0) ? steps : 200;
        pinMode(stepperDirPin, OUTPUT);
        pinMode(stepperStepPin, OUTPUT);
        digitalWrite(stepperDirPin, LOW);
        digitalWrite(stepperStepPin, LOW);
        stepperInitialized = true;
        server.send(200, "text/plain", "OK");
      } else {
        server.send(400, "text/plain", "INVALID_FORMAT");
      }
      return;
    }

    // ================= STEPPER ROTATE =================
    if (cmd.startsWith("STEPPER_ROTATE")) {
      char dirStr[10];
      int speedUs, steps;
      if (sscanf(cmd.c_str(), "STEPPER_ROTATE %s %d %d", dirStr, &speedUs, &steps) == 3 && stepperInitialized) {
        int dirVal = (strcmp(dirStr, "HIGH") == 0) ? HIGH : LOW;
        digitalWrite(stepperDirPin, dirVal);
        if (speedUs <= 0) speedUs = 1000;
        for (int i = 0; i < steps; i++) {
          digitalWrite(stepperStepPin, HIGH);
          delayMicroseconds(speedUs);
          digitalWrite(stepperStepPin, LOW);
          delayMicroseconds(speedUs);
        }
        server.send(200, "text/plain", "OK");
      } else {
        server.send(400, "text/plain", "NOT_INITIALIZED");
      }
      return;
    }

    // ================= UNKNOWN COMMAND =================
    server.send(400, "text/plain", "UNKNOWN");
  });

  server.begin();
  Serial.println("HTTP Server Started");
}


void repeat();

void setup() {

Serial.begin(115200);
delay(500);

OTA.setWiFi(DEFAULT_SSID, DEFAULT_PASS);   // OTA uses the same default WiFi
OTA.onOtaMode(stopBlockzie);
OTA.begin("Blockzie");

loadWiFiCredentials();
initializeWiFi();
}

void loop() {
  OTA.loop();          // must stay the first line of loop()
  repeat();
}

void repeat() {

server.handleClient();
{
  static unsigned long lastWifiTry = 0;
  static wl_status_t lastWifiSt = WL_IDLE_STATUS;
  wl_status_t st = WiFi.status();
  if (st != lastWifiSt) {
    lastWifiSt = st;
    if (st == WL_CONNECTED) {
      IPAddress ip = WiFi.localIP();
      Serial.println("Connected to WiFi");
      Serial.print("IP ");
      Serial.print((int)ip[0]);
      Serial.print(".");
      Serial.print((int)ip[1]);
      Serial.print(".");
      Serial.print((int)ip[2]);
      Serial.print(".");
      Serial.println((int)ip[3]);
      Serial.println("HTTP Server Started");
    }
  }
  if (st != WL_CONNECTED && (millis() - lastWifiTry) > 8000UL) {
    lastWifiTry = millis();
    Serial.println("WiFi reconnecting...");
    WiFi.begin(ssid, password);
  }
}
