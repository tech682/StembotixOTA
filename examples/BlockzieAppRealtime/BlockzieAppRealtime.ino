      if (sscanf(cmd.c_str(), "RGBLED_SET_FOR %d %d %d %d %15s", &pin, &r, &g, &b, secondsText) == 5) {
        RgbLedEntry* px = rgbLedGetEntry(pin);
        if (px != nullptr) {
          px->r = constrain(r, 0, 255);
          px->g = constrain(g, 0, 255);
          px->b = constrain(b, 0, 255);
          rgbLedApply(px);
          delay((unsigned long)(String(secondsText).toFloat() * 1000.0f));
          px->r = px->g = px->b = 0;
          rgbLedApply(px);
          server.send(200, "text/plain", "OK");
        } else {
          server.send(400, "text/plain", "NOT_INITIALIZED");
        }
      } else {
        server.send(400, "text/plain", "INVALID_FORMAT");
      }
      return;
