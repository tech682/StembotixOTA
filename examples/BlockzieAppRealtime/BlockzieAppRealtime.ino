        RgbLedEntry* px = rgbLedGetEntry(pin);
        if (px != nullptr) {
          if (channel[0] == 'R' || channel[0] == 'r') px->r = constrain((int)px->r + delta, 0, 255);
          else if (channel[0] == 'G' || channel[0] == 'g') px->g = constrain((int)px->g + delta, 0, 255);
          else if (channel[0] == 'B' || channel[0] == 'b') px->b = constrain((int)px->b + delta, 0, 255);
          else { server.send(400, "text/plain", "INVALID_CHANNEL"); return; }
          rgbLedApply(px);
          server.send(200, "text/plain", "OK");
        } else {
