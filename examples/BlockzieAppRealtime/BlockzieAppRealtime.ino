    // ================= RGB LED (NeoPixel) =================
    if (cmd.startsWith("RGBLED_INIT")) {
      int portOrPin, rgbPin;
      int count = sscanf(cmd.c_str(), "RGBLED_INIT %d %d", &portOrPin, &rgbPin);
      if (count == 1) rgbPin = portOrPin;
      if (count == 2 && portOrPin >= 1 && portOrPin <= RGBLED_MAX_STRIPS) rgbLedPortPin[portOrPin] = rgbPin;
      if (count >= 1 && rgbLedGetEntry(rgbPin) != nullptr) {
        server.send(200, "text/plain", "OK");
      } else {
        server.send(400, "text/plain", count >= 1 ? "INIT_FAILED" : "INVALID_FORMAT");
      }
      return;
    }

    if (cmd.startsWith("RGBLED_SET_CHANNEL")) {
      int pin, channelValue;
      char channel[4];
      if (sscanf(cmd.c_str(), "RGBLED_SET_CHANNEL %d %3s %d", &pin, channel, &channelValue) == 3) {
        RgbLedEntry* px = rgbLedGetEntry(pin);
        if (px != nullptr) {
          channelValue = constrain(channelValue, 0, 255);
          if (channel[0] == 'R' || channel[0] == 'r') px->r = channelValue;
          else if (channel[0] == 'G' || channel[0] == 'g') px->g = channelValue;
          else if (channel[0] == 'B' || channel[0] == 'b') px->b = channelValue;
          else { server.send(400, "text/plain", "INVALID_CHANNEL"); return; }
          rgbLedApply(px);
          server.send(200, "text/plain", "OK");
        } else {
          server.send(400, "text/plain", "NOT_INITIALIZED");
        }
      } else {
        server.send(400, "text/plain", "INVALID_FORMAT");
      }
      return;
    }

    if (cmd.startsWith("RGBLED_CHANGE_CHANNEL")) {
