        if (!strcasecmp(direction, "right")) oledDisplay->startscrollright(y0, y1);
        else if (!strcasecmp(direction, "left")) oledDisplay->startscrollleft(y0, y1);
        else if (!strcasecmp(direction, "diagright")) oledDisplay->startscrolldiagright(y0, y1);
        else if (!strcasecmp(direction, "diagleft")) oledDisplay->startscrolldiagleft(y0, y1);
